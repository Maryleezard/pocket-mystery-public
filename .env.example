# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# Pliku .env.local nikomu nie wysyłaj i nie wklejaj kluczy do czatu.

# Klucz API Claude z console.anthropic.com (API Keys). Tajny.
ANTHROPIC_API_KEY=

# Supabase: Project Settings -> API Keys / Data API.
# Adres projektu i klucz publiczny (publishable) mogą trafić do przeglądarki.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Klucz sekretny (secret) daje pełny dostęp do bazy. Tajny, tylko na serwerze.
SUPABASE_SECRET_KEY=

# Adres autorki: tylko ona widzi licznik kosztów w grze.
AUTORKA_EMAIL=

# Publiczne wydanie: ustaw na 1, a każdy zweryfikowany adres e-mail będzie mógł założyć konto.
# Puste = tylko osoby z listy testerów. W Supabase (Authentication) muszą być dozwolone nowe rejestracje.
REJESTRACJA_OTWARTA=
